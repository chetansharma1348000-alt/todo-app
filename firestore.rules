rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Starter rules for development. Tighten before shipping anywhere public.
    match /users/{userId} {
      allow read: if true; // needed so the Back Office "Users" grid can list everyone
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /taskLists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
